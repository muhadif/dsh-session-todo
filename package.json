{
  "name": "dsh-session-todo",
  "version": "1.3.0",
  "type": "module",
  "description": "Workspace-scoped PRDs and a kanban task board for [DSH]: each PRD is owned by the session that wrote it and backs many tasks, every card links to its PRD rendered as Markdown, and a task opens a Jira-like detail panel with description, priority, labels, comments and history.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.1"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "todo",
    "kanban",
    "prd",
    "task-board",
    "jira",
    "planning",
    "session"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhadif/dsh-session-todo.git"
  },
  "homepage": "https://github.com/muhadif/dsh-session-todo#readme",
  "bugs": {
    "url": "https://github.com/muhadif/dsh-session-todo/issues"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  }
}
